# ==============================================================================
# AI CareerGuide — Mẫu Biến Môi Trường Chuẩn (.env.example)
# Sao chép file này thành `.env` ở thư mục gốc khi chạy local / Docker,
# hoặc khai báo các biến tương ứng trên Render (Backend) & Vercel (Frontend).
# TUYỆT ĐỐI KHÔNG commit file `.env` chứa khóa bí mật thật lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH MÔI TRƯỜNG, SERVER & CORS
# ------------------------------------------------------------------------------
# Chế độ chạy: "development" (local/Docker) hoặc "production" (Render/cloud)
ENVIRONMENT=development
# Cổng HTTP của Backend FastAPI và Frontend Vite khi chạy local/Docker
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_ALT_PORT=3000
# Danh sách domain Frontend được phép gọi API (JSON array hoặc chuỗi cách nhau dấu phẩy)
# Production ví dụ: ["https://ai-careerguide-ten.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# Thông số container PostgreSQL khi chạy Docker Compose local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_careerguide
POSTGRES_PORT=5432
POSTGRES_VOLUME=careerguide1_dev_data
# Chuỗi kết nối async SQLAlchemy tới PostgreSQL (Supabase/Neon/Render đều tự chuẩn hóa sang postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_careerguide

# ------------------------------------------------------------------------------
# 3. BẢO MẬT & XÁC THỰC JWT (OWASP ASVS Level 2, Argon2id)
# ------------------------------------------------------------------------------
# Khóa ký JWT (>= 32 ký tự ngẫu nhiên; production BẮT BUỘC khác mặc định):
# Tạo nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-use-a-random-32-plus-char-secret
# Thuật toán ký JWT và thời hạn token đăng nhập (phút; 1440 = 24 giờ)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. ĐĂNG NHẬP GOOGLE OAUTH 2.0 (Authorization Code Flow)
# ------------------------------------------------------------------------------
# OAuth Client ID & Secret lấy từ Google Cloud Console -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# URL callback khớp 100% với Authorized redirect URIs trên Google Cloud Console
# Local: http://localhost:5173/login/callback | Production: https://<frontend-domain>/login/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/login/callback

# ------------------------------------------------------------------------------
# 5. BIẾN MÔI TRƯỜNG FRONTEND (đặt trong frontend/.env hoặc Vercel)
# ------------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/login/callback

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH AI RUNTIME, LLM GATEWAY & TÌM KIẾM TAVILY
# ------------------------------------------------------------------------------
# Giao thức & chế độ xác thực ("openai_compatible" / "BEARER")
LLM_PROTOCOL=openai_compatible
LLM_AUTH_MODE=BEARER
# Base URL của cổng AI (ví dụ xKiro AI Gateway: https://api.xkiro.com/v1)
LLM_BASE_URL=https://api.xkiro.com/v1
# Model mặc định dùng cho Chatbot Tư vấn, Giải thích ngành, Phân tích kỹ năng & Nguyện vọng AI
LLM_MODEL=cohere/command-a-plus
# Danh sách model khả dụng hiển thị ở mục trạng thái Admin (phân cách bằng dấu phẩy)
LLM_AVAILABLE_MODELS=mistralai/mistral-large-2512,mistralai/mistral-medium-3.5,mistralai/mistral-small-2603,cohere/command-a-plus,cohere/command-a,cohere/command-a-reasoning,mistralai/ministral-14b,sensenova/sensenova-6.8-flash-lite
# API key gọi LLM Gateway (tuyệt đối giữ bí mật)
LLM_API_KEY=
# Khóa Fernet 32-byte (tùy chọn, tương thích mã hóa/Render env; AI runtime đọc trực tiếp từ ENV):
# Tạo nhanh: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CONFIG_ENCRYPTION_KEY=
AI_CONFIG_ENCRYPTION_KEY_ID=primary
# Whitelist URL nội bộ cho môi trường test/dev (production luôn chặn IP nội bộ để chống SSRF)
AI_LOCAL_ALLOWED_BASE_URLS=[]
AI_PROBE_LIMIT_PER_MINUTE=6
# Model embedding & kích thước vector pgvector (text-embedding-3-small = 1536 chiều)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# API Key Tavily Web Search dùng cho Trend Agent cập nhật xu hướng ngành
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# 7. GỬI EMAIL OTP XÁC NHẬN ĐĂNG KÝ & QUÊN MẬT KHẨU
# ------------------------------------------------------------------------------
# URL Google Apps Script Webhook (gửi OTP qua HTTPS 443)
MAIL_WEBHOOK_URL=
# Chuỗi bí mật ký/xác thực giữa Backend và Apps Script Webhook (tự đặt chuỗi ngẫu nhiên)
MAIL_WEBHOOK_SECRET=
# Thời hạn OTP (phút), thời gian chờ gửi lại (giây), số lần nhập sai tối đa
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 8. TRỌNG SỐ THUẬT TOÁN ĐỀ XUẤT 3 TRỤ CỘT & BOOTSTRAP ADMIN (TÙY CHỌN)
# ------------------------------------------------------------------------------
# Mặc định: Sở thích RIASEC (0.45) + Học lực (0.35) + Thiên hướng nhận thức (0.20)
WEIGHT_RIASEC=0.45
WEIGHT_ACADEMIC=0.35
WEIGHT_PREFERENCE=0.20
# Tài khoản Admin tự khởi tạo khi chạy backend/scripts/init_db.py lúc deploy
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Quản trị viên Hệ thống
BOOTSTRAP_ADMIN_RESET_PASSWORD=false
