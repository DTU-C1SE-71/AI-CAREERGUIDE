# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_careerguide
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_careerguide

# Security & Authentication (OWASP ASVS Level 2, Argon2id, JWT)
SECRET_KEY=ai_careerguide_super_secret_jwt_key_2026_owasp_compliant_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Configuration (Official Authorization Code Flow)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/login/callback

# Frontend Client Environment Variables (.env for frontend)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/login/callback

# AI profile — nguyên khối, không trộn OPENAI/XAI legacy fields
LLM_PROTOCOL=openai_compatible
LLM_BASE_URL=https://codex.fosta.app/v1
LLM_MODEL=gpt-6-luna
LLM_AUTH_MODE=BEARER
LLM_API_KEY=
# Fernet key độc lập JWT. Khởi tạo bằng hướng dẫn vận hành; không dùng placeholder.
AI_CONFIG_ENCRYPTION_KEY=
AI_CONFIG_ENCRYPTION_KEY_ID=primary
# Chỉ test/dev, allowlist đúng toàn bộ base URL; production luôn chặn private IP.
AI_LOCAL_ALLOWED_BASE_URLS=[]
AI_PROBE_LIMIT_PER_MINUTE=6
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
TAVILY_API_KEY=

# Server & Environment Settings
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 3-Pillar Scoring Weights (Default: RIASEC 0.45, Academic 0.35, Preference 0.20)
WEIGHT_RIASEC=0.45
WEIGHT_ACADEMIC=0.35
WEIGHT_PREFERENCE=0.20


# Email Delivery (OTP Xác nhận đăng ký & Quên mật khẩu)
# Cách 1 (Khuyên dùng cho Render Free - qua HTTPS 443, 300 mail/ngày, gửi được cho mọi email bằng Gmail đã verify):
BREVO_API_KEY=
# Cách 2: Resend API (cần domain riêng nếu gửi cho email ngoài chủ tài khoản)
RESEND_API_KEY=
# Cách 2: Gmail SMTP (dùng App Password 16 ký tự; bỏ trống RESEND_API_KEY để dùng SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI CareerGuide
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
