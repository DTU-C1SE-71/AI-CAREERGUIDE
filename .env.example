# ==============================================================================
# AI CareerGuide — Environment Variables Template (.env.example)
# Sao chép file này thành .env (local) hoặc cấu hình trên Render / Vercel.
# TUYỆT ĐỐI KHÔNG commit file .env chứa khóa thật lên Git.
# ==============================================================================

# 1. Database Configuration (PostgreSQL 16 + pgvector / Supabase)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_careerguide
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_careerguide

# 2. Security & Authentication (OWASP ASVS Level 2, Argon2id, JWT)
# Production bắt buộc dùng chuỗi ngẫu nhiên >= 32 ký tự (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-use-a-random-32-plus-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Bootstrap Admin Account (tùy chọn — dùng bởi backend/scripts/init_db.py khi deploy)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Quản trị viên Hệ thống
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# 4. Google OAuth 2.0 Configuration (Authorization Code Flow)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/login/callback

# 5. Frontend Client Environment Variables (đặt trong frontend/.env hoặc Vercel)
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/login/callback

# 6. AI Runtime & LLM Configuration (OpenAI-compatible / xKiro AI Gateway)
LLM_PROTOCOL=openai_compatible
LLM_BASE_URL=https://api.xkiro.com/v1
LLM_MODEL=mistralai/mistral-large-2512
# Danh sách model hiển thị ở mục "Chọn nhanh model" trên trang Admin (phân cách bằng dấu phẩy)
LLM_AVAILABLE_MODELS=mistralai/mistral-large-2512,mistralai/mistral-medium-3.5,mistralai/mistral-small-2603,cohere/command-a-plus,cohere/command-a,cohere/command-a-reasoning,mistralai/ministral-14b,sensenova/sensenova-6.8-flash-lite
LLM_AUTH_MODE=BEARER
LLM_API_KEY=
# Fernet key mã hóa cấu hình AI lưu DB (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AI_CONFIG_ENCRYPTION_KEY=
AI_CONFIG_ENCRYPTION_KEY_ID=primary
# Chỉ dùng cho test/dev; production luôn chặn private IP
AI_LOCAL_ALLOWED_BASE_URLS=[]
AI_PROBE_LIMIT_PER_MINUTE=6
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
TAVILY_API_KEY=

# 7. Server & CORS Settings
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 8. 3-Pillar Scoring Weights (Default: RIASEC 0.45, Academic 0.35, Preference 0.20)
WEIGHT_RIASEC=0.45
WEIGHT_ACADEMIC=0.35
WEIGHT_PREFERENCE=0.20

# 9. Email Delivery (OTP Xác nhận đăng ký & Quên mật khẩu)
# Cách 1 (Khuyên dùng cho Render Free — qua HTTPS 443 bằng Google Apps Script Webhook):
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
# Cách 2: Brevo HTTP API (HTTPS 443, 300 mail/ngày miễn phí)
BREVO_API_KEY=
# Cách 3: Resend API (cần domain riêng nếu gửi ra ngoài email chủ tài khoản)
RESEND_API_KEY=
# Cách 4: Gmail SMTP (dùng App Password 16 ký tự; các PaaS miễn phí như Render Free có thể chặn cổng 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI CareerGuide
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
